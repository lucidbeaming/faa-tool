# Required — Mistral API key (same account/key style as chatjc)
MISTRAL_API_KEY=your-mistral-api-key

# Mistral model (default: mistral-small-latest)
MISTRAL_CHAT_MODEL=mistral-small-latest

# Guardrails
MAX_INPUT_LENGTH=500
MAX_RESPONSE_LENGTH=1200
MAX_RESPONSE_TOKENS=300

# Rate limiting (per IP, plus a site-wide hourly ceiling)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=600000
GLOBAL_RATE_LIMIT_MAX=600

# Server port (default 9004; parent site uses 9001)
PORT=9004
